{
  "name": "@shipgate/core",
  "version": "1.0.0",
  "description": "Pure policy, secret scanning, and ship planning for Shipgate",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
